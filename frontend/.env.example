# Regional Rapid Responder Environment Variables

# 1. Google OAuth 2.0 Web Application Client ID
# Create in Google Cloud Console (https://console.cloud.google.com/apis/credentials)
# Type: Web application
# Authorized JavaScript origins: https://rrr-frontend-ten.vercel.app, http://localhost:5173
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# 2. Production Backend API & WebSocket URLs (Render)
VITE_API_BASE_URL=https://rrr-backend-knml.onrender.com/api
VITE_WS_URL=https://rrr-backend-knml.onrender.com/ws
