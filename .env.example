# Regional Rapid Responder Environment Variables

# 1. Google OAuth 2.0 Web Application Client ID
# Set in Vercel Project Settings -> Environment Variables -> VITE_GOOGLE_CLIENT_ID
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# 2. Production Backend API & WebSocket URLs (Render)
VITE_API_BASE_URL=https://rrr-backend-knml.onrender.com/api
VITE_WS_URL=https://rrr-backend-knml.onrender.com/ws
